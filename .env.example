# ─── Режим развёртывания ───────────────────────────────────────────────
# domain — свой домен + автоматический HTTPS (Let's Encrypt)
# ip     — без домена, панель по HTTP на PANEL_PORT
DEPLOY_MODE=ip

# Только для DEPLOY_MODE=domain
PANEL_DOMAIN=panel.example.com
ACME_EMAIL=admin@example.com

# Только для DEPLOY_MODE=ip
PANEL_PORT=4250

# Публичный адрес панели — по нему собираются ссылки на фото рассылок,
# которые скачивают серверы Telegram. install.sh/update.sh заполняют сами;
# при ручной настройке впишите реальный адрес (https://domain или
# http://IP:PORT) — иначе фото в рассылках не будут отправляться.
PANEL_PUBLIC_URL=

# Секретный путь панели. Если задан (например PANEL_SECRET_PATH=k7f2q9x1),
# панель открывается только по адресу https://ваш-домен/k7f2q9x1 — браузер
# запоминает пропуск на 30 дней, а всем остальным сервер отвечает пустым 404
# (не видно ни страницы входа, ни того, что тут вообще панель).
# Пусто — панель доступна по корневому адресу, как раньше.
PANEL_SECRET_PATH=

# ─── Секреты (генерируются install.sh, не коммитить) ───────────────────
POSTGRES_PASSWORD=
# openssl rand -hex 32 — подпись JWT
SECRET_KEY=
# Fernet-ключ для шифрования токенов провайдеров в БД:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ─── База и кэш ────────────────────────────────────────────────────────
POSTGRES_USER=vpnpanel
POSTGRES_DB=vpnpanel
DATABASE_URL=postgresql+asyncpg://vpnpanel:${POSTGRES_PASSWORD}@postgres:5432/vpnpanel
REDIS_URL=redis://redis:6379/0

# ─── Прочее ────────────────────────────────────────────────────────────
TZ=Europe/Moscow
LOG_LEVEL=INFO
